{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "effort_scope_id",
    "hours_per_day",
    "basis"
  ],
  "properties": {
    "schema_version": {
      "const": "oes/calculation-basis/v1"
    },
    "environment": {
      "const": "TEST"
    },
    "effort_scope_id": {
      "const": "oes-design-implementation-test-v1"
    },
    "hours_per_day": {
      "const": 8
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_set_id": {
          "const": "oes-local-test-2026-10-v1"
        },
        "engine_version": {
          "const": "0.8.1-quality"
        },
        "mapping_version": {
          "const": "oes-cosmic-ph1-v1"
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "oes-test-benchmark-design-implementation-test-v1"
            },
            "is_test": {
              "const": true
            },
            "sample_size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "min_cfp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_cfp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hours_per_cfp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "p25": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                "median": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                "p75": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                }
              },
              "required": [
                "p25",
                "median",
                "p75"
              ]
            }
          },
          "required": [
            "id",
            "is_test",
            "sample_size",
            "min_cfp",
            "max_cfp",
            "hours_per_cfp"
          ]
        },
        "wage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "oes-test-wage-50usd-v1"
            },
            "is_test": {
              "const": true
            },
            "hourly_wage_usd": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "required": [
            "id",
            "is_test",
            "hourly_wage_usd"
          ]
        }
      },
      "required": [
        "profile_set_id",
        "engine_version",
        "mapping_version",
        "benchmark",
        "wage"
      ]
    }
  }
}
