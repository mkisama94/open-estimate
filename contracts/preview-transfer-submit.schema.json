                                "variant": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9999
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "type",
                                "group",
                                "peer",
                                "store",
                                "distinct",
                                "variant"
                              ],
                              "additionalProperties": false
                            },
                            "maxItems": 1000
                          }
                        },
                        "required": [
                          "status",
                          "trigger_user",
                          "trigger_group",
                          "movements"
