                          "trigger_user": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9999
                          },
                          "trigger_group": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9999
                          },
                          "movements": {
                            "type": "array",
                            "items": {
