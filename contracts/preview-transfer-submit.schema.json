                                "type": {
                                  "enum": [
                                    "Entry",
                                    "Exit",
                                    "Read",
                                    "Write"
                                  ]
                                },
                                "group": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9999
                                },
                                "peer": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9999
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
