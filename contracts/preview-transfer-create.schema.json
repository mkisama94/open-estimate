{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_commitment",
    "metadata_hash",
    "policy_version",
    "client_secret_hash"
  ],
  "properties": {
    "input_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "algorithm",
        "digest"
      ],
      "properties": {
        "domain": {
          "const": "oes/certificate-input-commitment/v1"
        },
        "algorithm": {
          "const": "SHA-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "metadata_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "const": "oes/certificate-publication-policy/v1"
    },
    "client_secret_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
