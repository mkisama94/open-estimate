{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation",
    "quality",
    "expected_report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "oes/owner-estimate-input/v1"
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "model": {
          "type": "object",
          "properties": {
            "version": {
              "enum": [
                "oes/remote-model/v1",
                "oes/remote-model/v2"
              ]
            },
            "unadopted_process_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "analysis_complete": {
              "type": "boolean"
            },
            "partial": {
              "type": "boolean"
            },
            "applicability_limit": {
              "type": "boolean"
            },
            "users": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "stores": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "maxItems": 10000
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "accepted",
                      "unresolved"
                    ]
                  },
                  "trigger_user": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "trigger_group": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "movements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "enum": [
                            "Entry",
                            "Exit",
                            "Read",
                            "Write"
                          ]
                        },
                        "group": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9999
                        },
                        "peer": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9999
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "store": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9999
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "distinct": {
                          "type": "boolean"
                        },
                        "variant": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9999
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "group",
                        "peer",
                        "store",
                        "distinct",
                        "variant"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 1000
                  }
                },
                "required": [
                  "status",
                  "trigger_user",
                  "trigger_group",
                  "movements"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            }
          },
          "required": [
            "version",
            "analysis_complete",
            "partial",
            "applicability_limit",
            "users",
            "stores",
            "groups",
            "processes"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "version": {
                    "const": "oes/remote-model/v2"
                  }
                }
              },
              "then": {
                "required": [
                  "unadopted_process_count"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "unadopted_process_count"
                  ]
                }
              }
            }
          ]
        },
        "display_currency": {
          "enum": [
            "USD",
            "JPY",
            "EUR",
            "GBP",
            "AUD",
            "NZD",
            "CAD",
            "CHF",
            "CNY",
            "HKD",
            "INR",
            "KRW",
            "SGD"
          ]
        },
        "skill_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "skill_id",
            "skill_version",
            "hash_rule",
            "package_sha256"
          ],
          "properties": {
            "format": {
              "const": "oes/skill-integrity/v1"
            },
            "skill_id": {
              "const": "open-estimate-assessor"
            },
            "skill_version": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            },
            "hash_rule": {
              "const": "oes/skill-package/v1"
            },
            "package_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "ruleset_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ruleset_id": {
              "const": "oes-measurement"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ruleset_id",
            "revision"
          ]
        }
      },
      "required": [
        "model",
        "display_currency",
        "skill_integrity",
        "ruleset_ref"
      ],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_format": {
          "const": "RECORDED_V2"
        },
        "quality_version": {
          "const": "oes/quality-records/v1"
        },
        "analysis_complete": {
          "type": "boolean"
        },
        "scan_complete": {
          "type": "boolean"
        },
        "provisional_process_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provisional_cfp_subtotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved_process_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidate_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "counted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outside": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "merged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "identified",
            "counted",
            "outside",
            "merged",
            "unresolved"
          ]
        },
        "unread_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in_scope": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outside": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "supporting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scope_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "in_scope",
            "outside",
            "supporting",
            "scope_unknown"
          ]
        },
        "unknown_boundary_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rerun": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "continuation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "rerun",
            "continuation"
          ]
        },
        "partial_reason_codes": {
          "type": "array",
          "items": {
            "enum": [
              "ACQUISITION_IN_SCOPE",
              "ACQUISITION_SCOPE_UNKNOWN",
              "BOUNDARY_CONTINUATION_UNKNOWN",
              "BOUNDARY_RERUN_UNKNOWN",
              "CANDIDATE_UNRESOLVED",
              "COMPONENT_SCOPE_IMPACT",
              "DATA_GROUP_UNCONFIRMED",
              "FILE_SCOPE_UNRESOLVED",
              "FINDING_OPEN",
              "IN_SCOPE_UNCONFIRMED",
              "JUDGMENT_PENDING",
              "PROCESS_CANDIDATE_MISSING",
              "PROCESS_UNRESOLVED",
              "SCAN_SCOPE_IMPACT_UNKNOWN"
            ]
          },
          "uniqueItems": true
        },
        "record_gap_codes": {
          "type": "array",
          "items": {
            "enum": [
              "EVIDENCE_INSUFFICIENT",
              "PROCESS_CANDIDATE_MISSING"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "record_format",
        "quality_version",
        "analysis_complete",
        "scan_complete",
        "provisional_process_count",
        "provisional_cfp_subtotal",
        "unresolved_process_count",
        "candidate_counts",
        "unread_counts",
        "unknown_boundary_counts",
        "partial_reason_codes",
        "record_gap_codes"
      ]
    },
    "expected_report_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
