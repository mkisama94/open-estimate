{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-estimate.org/schemas/ph1/v1/oes-ph1.schema.json",
  "title": "Open Estimate Ph1 Schemas",
  "definitions": {
    "Assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "assessor",
        "input",
        "scope",
        "components",
        "functional_users",
        "persistent_stores",
        "objects_of_interest",
        "data_groups",
        "evidence",
        "functional_processes",
        "findings",
        "human_amendments"
      ],
      "properties": {
        "assessment_id": { "type": "string" },
        "assessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "model_name",
            "model_metadata_source",
            "host",
            "skill_id",
            "skill_version",
            "skill_sha256",
            "started_at",
            "finished_at",
            "context_isolation"
          ],
          "properties": {
            "model_id": { "type": ["string", "null"] },
            "model_name": { "type": "string" },
            "model_metadata_source": { "type": "string", "enum": ["user_reported", "host_provided", "unknown"] },
            "host": { "type": "string" },
            "skill_id": { "type": "string" },
            "skill_version": { "type": "string" },
            "skill_sha256": { "type": "string" },
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "context_isolation": { "type": "string", "enum": ["not_enforced"] }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_label",
            "snapshot_type",
            "commit",
            "dirty",
            "manifest_hash",
            "manifest",
            "analysis_complete",
            "source_binding"
          ],
          "properties": {
            "repository_label": { "type": "string" },
            "snapshot_type": { "type": "string", "enum": ["worktree", "git_commit"] },
            "commit": { "type": ["string", "null"] },
            "dirty": { "type": "boolean" },
            "manifest_hash": { "type": "string" },
            "manifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["domain", "files"],
              "properties": {
                "domain": { "type": "string", "const": "oes/source-manifest/v1" },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "sha256", "bytes", "line_count", "disposition", "exclusion_reason"],
                    "properties": {
                      "path": { "type": "string" },
                      "sha256": { "type": "string" },
                      "bytes": { "type": "integer", "minimum": 0 },
                      "line_count": { "type": "integer", "minimum": 0 },
                      "disposition": { "type": "string", "enum": ["analyzed", "supporting", "unread", "excluded"] },
                      "exclusion_reason": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            },
            "analysis_complete": { "type": "boolean" },
            "source_binding": { "type": "string", "enum": ["client_reported"] }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregation", "measurement_purpose", "perspective", "description"],
          "properties": {
            "aggregation": { "type": "string", "const": "single_application_boundary" },
            "measurement_purpose": { "type": "string", "const": "as_built_functional_size" },
            "perspective": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_id", "name", "status", "scope_impact", "path_prefixes", "reason"],
            "properties": {
              "component_id": { "type": "string" },
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["measured", "excluded", "unresolved"] },
              "scope_impact": { "type": "boolean" },
              "path_prefixes": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string" }
            }
          }
        },
        "functional_users": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "name", "category", "description"],
            "properties": {
              "user_id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string", "enum": ["person", "external_system", "timer", "device"] },
              "description": { "type": "string" }
            }
          }
        },
        "persistent_stores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["store_id", "name", "storage_type", "description"],
            "properties": {
              "store_id": { "type": "string" },
              "name": { "type": "string" },
              "storage_type": { "type": "string", "enum": ["relational_db", "document_db", "key_value", "file_storage", "queue", "cache", "other"] },
              "description": { "type": "string" }
            }
          }
        },
        "objects_of_interest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_of_interest_id", "name", "description"],
            "properties": {
              "object_of_interest_id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "data_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data_group_id", "object_of_interest_id", "name", "attributes", "description"],
            "properties": {
              "data_group_id": { "type": "string" },
              "object_of_interest_id": { "type": "string" },
              "name": { "type": "string" },
              "attributes": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "file_path", "line_start", "line_end", "symbol", "evidence_type", "description"],
            "properties": {
              "evidence_id": { "type": "string" },
              "file_path": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "symbol": { "type": ["string", "null"] },
              "evidence_type": { "type": "string", "enum": ["source", "schema", "configuration", "test", "documentation", "other"] },
              "description": { "type": "string" }
            }
          }
        },
        "functional_processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["process_id", "component_id", "name", "description", "trigger_movement_id", "trigger_user_id", "status", "inferred", "decision_reason", "movements"],
            "properties": {
              "process_id": { "type": "string" },
              "component_id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "trigger_movement_id": { "type": "string" },
              "trigger_user_id": { "type": "string" },
              "status": { "type": "string", "enum": ["accepted", "unresolved"] },
              "inferred": { "type": "boolean" },
              "decision_reason": { "type": "string" },
              "movements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["movement_id", "type", "data_group_id", "peer_id", "store_id", "semantic_variant_key", "distinctness_basis", "distinctness_reason", "evidence_refs"],
                  "properties": {
                    "movement_id": { "type": "string" },
                    "type": { "type": "string", "enum": ["Entry", "Exit", "Read", "Write"] },
                    "data_group_id": { "type": "string" },
                    "peer_id": { "type": ["string", "null"] },
                    "store_id": { "type": ["string", "null"] },
                    "semantic_variant_key": { "type": ["string", "null"] },
                    "distinctness_basis": { "type": "string", "enum": ["default", "functional_variant", "multi_group", "distinct_event"] },
                    "distinctness_reason": { "type": ["string", "null"] },
                    "evidence_refs": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "category", "severity", "message", "evidence_refs"],
            "properties": {
              "finding_id": { "type": "string" },
              "category": { "type": "string", "enum": ["applicability_limit", "ambiguity", "unread_code", "suspicious_directive", "inferred_logic", "coverage_gap"] },
              "severity": { "type": "string", "enum": ["info", "warning", "blocking"] },
              "message": { "type": "string" },
              "evidence_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "human_amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["amendment_id", "target_pointer", "previous_hash", "reason"],
            "properties": {
              "amendment_id": { "type": "string" },
              "target_pointer": { "type": "string" },
              "previous_hash": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "assessment_id",
        "assessment_hash",
        "profile_set_id",
        "measurement",
        "assurance",
        "effort",
        "reference_usd",
        "localized_reference",
        "features",
        "limitation_codes",
        "generated_at"
      ],
      "properties": {
        "domain": { "type": "string", "const": "open-estimate/report/ph1/v1" },
        "assessment_id": { "type": "string" },
        "assessment_hash": { "type": "string" },
        "profile_set_id": { "type": ["string", "null"] },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "cfp", "counts"],
          "properties": {
            "status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "UNSUPPORTED", "INCOMPLETE"] },
            "cfp": { "type": ["integer", "null"] },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entry", "exit", "read", "write", "total_processes", "accepted_processes"],
              "properties": {
                "entry": { "type": "integer", "minimum": 0 },
                "exit": { "type": "integer", "minimum": 0 },
                "read": { "type": "integer", "minimum": 0 },
                "write": { "type": "integer", "minimum": 0 },
                "total_processes": { "type": "integer", "minimum": 0 },
                "accepted_processes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assessment_class", "context_isolation", "semantic_assessment"],
          "properties": {
            "assessment_class": { "type": "string", "const": "COMMUNITY" },
            "context_isolation": { "type": "string", "const": "not_enforced" },
            "semantic_assessment": { "type": "string", "const": "NOT_INDEPENDENTLY_VERIFIED" }
          }
        },
        "effort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "hours_per_cfp", "person_hours"],
          "properties": {
            "status": { "type": "string", "enum": ["AVAILABLE", "BENCHMARK_UNAVAILABLE", "OUTSIDE_REFERENCE_RANGE", "UNSUPPORTED"] },
            "hours_per_cfp": {
              "type": ["object", "null"],
              "properties": {
                "p25": { "type": "string" },
                "median": { "type": "string" },
                "p75": { "type": "string" }
              }
            },
            "person_hours": {
              "type": ["object", "null"],
              "properties": {
                "p25": { "type": "string" },
                "median": { "type": "string" },
                "p75": { "type": "string" }
              }
            }
          }
        },
        "reference_usd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "hourly_wage_usd", "amount_usd"],
          "properties": {
            "status": { "type": "string", "enum": ["AVAILABLE", "WAGE_UNAVAILABLE", "UNSUPPORTED"] },
            "hourly_wage_usd": { "type": ["string", "null"] },
            "amount_usd": {
              "type": ["object", "null"],
              "properties": {
                "p25": { "type": "string" },
                "median": { "type": "string" },
                "p75": { "type": "string" }
              }
            }
          }
        },
        "localized_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "currency", "currency_per_usd", "amount"],
          "properties": {
            "status": { "type": "string", "enum": ["AVAILABLE", "FX_UNAVAILABLE", "FX_STALE", "UNSUPPORTED"] },
            "currency": { "type": "string" },
            "currency_per_usd": { "type": ["string", "null"] },
            "amount": {
              "type": ["object", "null"],
              "properties": {
                "p25": { "type": "string" },
                "median": { "type": "string" },
                "p75": { "type": "string" }
              }
            }
          }
        },
        "features": { "type": "object" },
        "limitation_codes": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
