{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Estimate remote model v1",
  "type": "object",
  "properties": {
    "model": {
      "type": "object",
      "properties": {
        "version": {
          "const": "oes/remote-model/v1"
        },
        "analysis_complete": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "applicability_limit": {
          "type": "boolean"
        },
        "users": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "stores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "maxItems": 10000
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "unresolved"
                ]
              },
              "trigger_user": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "trigger_group": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "movements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "Entry",
                        "Exit",
                        "Read",
                        "Write"
                      ]
                    },
                    "group": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9999
                    },
                    "peer": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9999
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "store": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9999
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "distinct": {
                      "type": "boolean"
                    },
                    "variant": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9999
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "group",
                    "peer",
                    "store",
                    "distinct",
                    "variant"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 1000
              }
            },
            "required": [
              "status",
              "trigger_user",
              "trigger_group",
              "movements"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "version",
        "analysis_complete",
        "partial",
        "applicability_limit",
        "users",
        "stores",
        "groups",
        "processes"
      ],
      "additionalProperties": false
    },
    "display_currency": {
      "enum": [
        "USD",
        "JPY",
        "EUR",
        "GBP",
        "AUD",
        "NZD",
        "CAD",
        "CHF",
        "CNY",
        "HKD",
        "INR",
        "KRW",
        "SGD"
      ]
    }
  },
  "required": [
    "model",
    "display_currency"
  ],
  "additionalProperties": false
}
