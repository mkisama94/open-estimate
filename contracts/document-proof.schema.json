{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement",
    "signature"
  ],
  "properties": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "algorithm",
        "issuer",
        "proof_id",
        "issued_at",
        "document_sha256",
        "ruleset_ref",
        "verification",
        "verification_method",
        "scope",
        "limitations",
        "key_id",
        "environment"
      ],
      "properties": {
        "schema_version": {
          "const": "oes/document-proof/v1"
        },
        "domain": {
          "const": "oes/calculation-verified-document/v1"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 200
        },
        "proof_id": {
          "type": "string",
          "pattern": "^docp_[a-f0-9]{32}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 24
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleset_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ruleset_id": {
              "const": "oes-measurement"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ruleset_id",
            "revision"
          ]
        },
        "verification": {
          "const": "CALCULATION_VERIFIED"
        },
        "verification_method": {
          "const": "oes/numeric-document-verification/v1"
        },
        "scope": {
          "const": [
            "DOCUMENT_FORMAT",
            "NUMERIC_CONSISTENCY",
            "RULESET_REFERENCE",
            "DOCUMENT_BINDING"
          ]
        },
        "limitations": {
          "const": [
            "SOURCE_COVERAGE_CLIENT_REPORTED",
            "AI_SEMANTICS_NOT_AUDITED",
            "FX_AUTHENTICITY_NOT_AUDITED",
            "ACTUAL_EFFORT_NOT_GUARANTEED",
            "SUBMITTER_IDENTITY_NOT_VERIFIED",
            "FREE_TEXT_NOT_VERIFIED"
          ]
        },
        "key_id": {
          "type": "string",
          "pattern": "^doc_(test|prod)_[a-f0-9]{32}$"
        },
        "environment": {
          "enum": [
            "test",
            "production"
          ]
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
