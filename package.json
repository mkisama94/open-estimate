{
  "name": "open-estimate",
  "version": "0.4.0",
  "description": "Open Estimate — functional size measurement and estimation based on COSMIC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-estimate": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/update-skill-manifest.mjs && node scripts/build-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:stdio": "node dist/index.js",
    "start": "node dist/index.js",
    "dev:web": "wrangler dev",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "plugin:pack": "node scripts/package-plugin.mjs",
    "plugin:smoke": "node scripts/smoke-desktop.mjs",
    "fx:check": "node scripts/check-frb.mjs",
    "helper": "node dist/local/cli.js",
    "dev:mcp": "wrangler dev --config wrangler.mcp.jsonc",
    "deploy:mcp:check": "wrangler deploy --config wrangler.mcp.jsonc --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.0.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.140.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0"
}
