{
  "name": "open-estimate",
  "version": "0.8.1",
  "description": "Open Estimate — functional size measurement and estimation based on COSMIC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-estimate": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/build-measurement-rules.mjs && node scripts/update-skill-manifest.mjs && node scripts/build-contracts.mjs",
    "build:worker": "node scripts/clean-dist.mjs && tsc && node scripts/build-measurement-rules.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:stdio": "node dist/index.js",
    "start": "node dist/index.js",
    "dev:web": "wrangler dev",
    "dev:public-result": "vite-node tests/fixtures/public-result-browser-host.ts",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "ci:mcp:build": "npm run build && node scripts/ci-mcp.mjs check && npm test -- --maxWorkers=2 && wrangler deploy --config wrangler.mcp.jsonc --dry-run",
    "ci:mcp:deploy": "node scripts/ci-mcp.mjs deploy",
    "ci:mcp:verify": "node scripts/ci-mcp.mjs verify",
    "plugin:pack": "node scripts/package-plugin.mjs",
    "plugin:smoke": "node scripts/smoke-desktop.mjs",
    "fx:check": "node scripts/check-frb.mjs",
    "helper": "node dist/local/cli.js",
    "dev:mcp": "wrangler dev --config wrangler.mcp.jsonc",
    "deploy:mcp": "node scripts/release-plugin.mjs deploy",
    "deploy:mcp:check": "node scripts/release-plugin.mjs check",
    "release:prepare": "node scripts/release-plugin.mjs prepare",
    "release:publish": "node scripts/release-plugin.mjs publish",
    "release": "node scripts/release-plugin.mjs release",
    "rules:prepare": "node scripts/release-rules.mjs prepare",
    "rules:publish": "node scripts/release-rules.mjs publish",
    "rules:release": "node scripts/release-rules.mjs release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.0.0",
    "decimal.js": "^10.6.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.140.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0"
}
