{
  "name": "open-estimate",
  "version": "0.1.0",
  "description": "Open Estimate — functional size measurement and estimation based on COSMIC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-estimate": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
